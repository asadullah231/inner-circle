# ---- object storage (MinIO in dev, S3 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=avgadmin
S3_SECRET_KEY=change-me-in-real-life
S3_BUCKET=avg-media
S3_UPLOADS_BUCKET=avg-uploads
S3_TMP_BUCKET=avg-tmp
S3_REGION=us-east-1
S3_SECURE=false

# ---- signed URL lifetimes (seconds) ----
SIGNED_URL_TTL_PREVIEW_S=1800
SIGNED_URL_TTL_DOWNLOAD_S=18000
SIGNED_URL_TTL_WORKER_S=1800
SIGNED_URL_TTL_UPLOAD_S=900

# ---- retention (days, except staging which is hours) ----
RETENTION_TMP_DAYS=1
RETENTION_UPLOADS_DAYS=7
RETENTION_ASSET_DAYS=30
RETENTION_RENDER_STAGING_HOURS=24
RETENTION_MAX_DELETIONS=500

# ---- local ----
FFPROBE_PATH=ffprobe
WORKSPACE_ROOT=./workspace
LOG_LEVEL=INFO